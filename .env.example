# Copy to .env (git-ignored) for local development.
# Both values are in the Supabase dashboard: Project Settings > API.
# They are public by design: Row Level Security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# NEVER put the service_role key in this app, in .env, or in the repository.
