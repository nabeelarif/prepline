  "narrative": {
    "northStar": "The Trailhead",
    "overview": "A study plan is a road with a date at the end of it, so the interface is drawn like a trail map kept in a field notebook: a deep pine bar, a cool mist ground, serif plan titles, and a path of waypoints. Finished stretches are solid pine, what is left is dotted footprints, and exactly one waypoint is amber: the next step.",
    "keyCharacteristics": [
      "Pine does the work; lake blue means in progress; amber means next; red means real schedule risk.",
      "Serif for what is named, humanist sans for everything operated.",
      "Flat sheets with a hairline edge; depth from tint and a soft offset shadow, never blur or glow.",
      "Dark mode is a re-lit version of the same trail, not an inversion."
    ],
    "rules": [
      {
        "name": "The One Amber Rule",
        "body": "Amber marks the next step and nothing else. If two things on a screen are amber, one of them is wrong.",
        "section": "colors"
      },
      {
        "name": "The No-Alarm Rule",
        "body": "Red appears only when the pace maths says the date is at risk. A plan with no progress yet is never red.",
        "section": "colors"
      },
      {
        "name": "The Token Rule",
        "body": "Colours come from the custom properties in tokens.css. A literal colour in a component is a bug.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every figure that changes or sits in a column uses tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The No Eyebrow Rule",
        "body": "A heading carries its own weight. No small capitalised label above it.",
        "section": "typography"
      },
      {
        "name": "The No-Glow Rule",
        "body": "No zero-offset coloured halos, no blur as decoration, no gradients.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use amber for the single next step and pine for finished work.",
      "Do keep red for real schedule risk, and word it with a way out.",
      "Do set plan and phase names in Newsreader and operate everything in Plus Jakarta Sans.",
      "Do give every control a 40px target (44px on touch) and a visible 2px focus ring.",
      "Do read colours from tokens.css and keep the light, OS-dark and [data-theme='dark'] blocks in step."
    ],
    "donts": [
      "Don't add a gradient, a glow, glass or a decorative blur.",
      "Don't put a coloured bar down one side of a rounded box.",
      "Don't place a small capitalised label above a heading.",
      "Don't nest cards, or turn the trail into a row of identical tiles.",
      "Don't show red, or the word \"behind\", for a plan that has no progress yet."
    ]
  }
